# ── Телеграм ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890
# ID пользователей, которым разрешены команды (через запятую).
# Пусто = отвечать всем; в проде так лучше не оставлять.
TELEGRAM_ADMINS=123456789

# Паузы между напоминаниями об аварии (critical), в минутах.
# Первое сообщение уходит сразу, дальше по списку; последнее значение
# повторяется, пока проблема не решится.
REPEAT_STEPS=3,5,8,10,30,60
# Как часто напоминать о предупреждениях (warning): диск, процессор, канал.
WARNING_REPEAT_HOURS=4
# Ночной режим по Москве: в эти часы всё, кроме critical, приходит без звука.
# Пусто — звук определяется только уровнем алерта.
QUIET_HOURS=0-8

# Служебные ноды, которые не показывать и по которым не алертить, —
# регулярное выражение по имени из панели. Выключенные в панели ноды
# бот узнаёт сам, их сюда вписывать не нужно.
NODES_IGNORE=ipcheker

# Адреса оверлейных сетей (NetBird, Tailscale), через которые панель ходит
# к части нод. Снаружи они не пингуются, поэтому такие ноды проверяются
# по реальному IP: из API NetBird, если в secrets/netbird_api_token лежит
# токен, или из targets/public-ip-overrides-<проект>.conf.
# Диапазоны через пробел или запятую. 100.64.0.0/10 — то, что NetBird
# раздаёт по умолчанию; если сеть в его настройках меняли, впишите свою.
# Можно задать отдельно для проекта: OVERLAY_RANGES_MAIN=...
OVERLAY_RANGES=100.64.0.0/10
# Адрес API NetBird. Менять, только если NetBird свой, а не облачный.
NETBIRD_API_URL=https://api.netbird.io

# ── Вебхуки от Remnawave ────────────────────────────────────────────────
# Тот же секрет, что указан в настройках вебхуков панели
REMNAWAVE_WEBHOOK_SECRET=

# ── Проекты ─────────────────────────────────────────────────────────────
# Список через пробел. Для каждого нужен свой набор переменных ниже
# и свои файлы в secrets/ и targets/.
PROJECTS="main most"
# Идентификатор первого проекта — им подписывается его бот
PROJECT_ID=main

# ── Проект main ─────────────────────────────────────────────────────────
PANEL_ADDR_MAIN=10.77.0.2:3001
PROBER_ADDR_MAIN=10.77.0.2:9115
# Адрес API панели. Надёжнее приватный: не зависит от домена и Cloudflare,
# и токен не уходит в интернет. Тогда рядом нужен PANEL_API_HOST_* — домен
# для заголовка Host, без него Remnawave 3.x обрывает запрос молча.
PANEL_API_URL_MAIN=https://panel.example.com
PANEL_API_HOST_MAIN=
PANEL_COOKIE_MAIN=
DEFAULT_XRAY_PORT_MAIN=443

# ── Проект most ─────────────────────────────────────────────────────────
PANEL_ADDR_MOST=10.77.0.4:3001
PROBER_ADDR_MOST=10.77.0.4:9115
PANEL_API_URL_MOST=http://10.77.0.5:3000
PANEL_API_HOST_MOST=panel.example.com
PANEL_COOKIE_MOST=
DEFAULT_XRAY_PORT_MOST=443
TELEGRAM_BOT_TOKEN_MOST=
TELEGRAM_CHAT_ID_MOST=
TELEGRAM_ADMINS_MOST=

# ── Хаб ─────────────────────────────────────────────────────────────────
# Адрес хаба в WireGuard-сети. Всё внутреннее слушает только на нём.
HUB_PRIVATE_IP=10.77.0.1
HUB_NAME=nl
# Сколько хранить метрики: 12 = год
RETENTION=12

# ── Прочее ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
# Сторож: если бот молчит дольше 30 минут, вам напишет внешний сервис.
# Заведите бесплатный чек на healthchecks.io и вставьте его URL.
HEALTHCHECKS_URL=
