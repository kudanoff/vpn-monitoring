# ── Телеграм ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890
# ID пользователей, которым разрешены команды (через запятую).
# Пусто = отвечать всем; в проде так лучше не оставлять.
TELEGRAM_ADMINS=123456789

# Ноды, которые не показывать и по которым не алертить —
# регулярное выражение по имени из панели.
NODES_IGNORE=archive|ipcheker

# ── Вебхуки от Remnawave ────────────────────────────────────────────────
# Тот же секрет, что указан в настройках вебхуков панели
REMNAWAVE_WEBHOOK_SECRET=

# ── Проекты ─────────────────────────────────────────────────────────────
# Список через пробел. Для каждого нужен свой набор переменных ниже
# и свои файлы в secrets/ и targets/.
PROJECTS="main most"
# Идентификатор первого проекта — им подписывается его бот
PROJECT_ID=main

# ── Проект main ─────────────────────────────────────────────────────────
PANEL_ADDR_MAIN=10.77.0.2:3001
PROBER_ADDR_MAIN=10.77.0.2:9115
PANEL_API_URL_MAIN=https://panel.example.com
PANEL_COOKIE_MAIN=
DEFAULT_XRAY_PORT_MAIN=443

# ── Проект most ─────────────────────────────────────────────────────────
PANEL_ADDR_MOST=10.77.0.4:3001
PROBER_ADDR_MOST=10.77.0.4:9115
PANEL_API_URL_MOST=https://df.smm-vpn.com
PANEL_COOKIE_MOST=
DEFAULT_XRAY_PORT_MOST=443
TELEGRAM_BOT_TOKEN_MOST=
TELEGRAM_CHAT_ID_MOST=
TELEGRAM_ADMINS_MOST=

# ── Хаб ─────────────────────────────────────────────────────────────────
# Адрес хаба в WireGuard-сети. Всё внутреннее слушает только на нём.
HUB_PRIVATE_IP=10.77.0.1
HUB_NAME=nl
# Сколько хранить метрики: 12 = год
RETENTION=12

# ── Прочее ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
# Сторож: если бот молчит дольше 30 минут, вам напишет внешний сервис.
# Заведите бесплатный чек на healthchecks.io и вставьте его URL.
HEALTHCHECKS_URL=
